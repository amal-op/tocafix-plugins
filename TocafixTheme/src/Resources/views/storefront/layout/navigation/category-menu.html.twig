{% block layout_navigation_category_menu %}
	{% set navigationMaxDepth = 3 %}

	{% if not level %}
		{% set level = 0 %}
	{% endif %}
	{% set activeId = page.header.navigation.active.id %}

	{% if page.product is defined %}
		{% set activePath = page.product.categoryTree %}
	{% else %}
		{% set activePath = page.header.navigation.active.path %}
	{% endif %}

	{% set categoryStrippedContent = categoryItem.description|striptags %}
	{% set categoryLink = category_url(categoryItem) %}

	<ul class="navigation-dropdown">
		{% for treeItem in navigationTree %}
			{% set id = treeItem.category.id %}
			{% set name = treeItem.category.translated.name %}
			{% set link = category_url(treeItem.category) %}

			{% block layout_navigation_categories_item %}
				<li class="navigation-dropdown-item {% if treeItem.children|length %}has-children{% endif %}">
					{% block layout_navigation_categories_item_link %}
						{% if treeItem.category.type == 'folder' %}
							<div class="nav-item nav-link is-level-{{ level }}" title="{{ name|raw }}">
								<span itemprop="name">{{ name|raw }}</span>
								{% if treeItem.children|length %}
								<span class="tf-icon icon-angle"></span>
								{% endif %}
							</div>
						{% else %}
							<a aria-label="category" class="nav-item nav-link is-level-{{ level }}{% if id == activeId or id in activePath %} active{% endif %}" href="{{ link }}" itemprop="url" {% if category_linknewtab(treeItem.category) %} target="_blank" {% endif %} title="{{ name|raw }}">
								<span itemprop="name">{{ name|raw }}</span>
								{% if treeItem.children|length %}
								<span class="tf-icon icon-angle"></span>
								{% endif %}
							</a>
						{% endif %}
					{% endblock %}

					{% block layout_navigation_categories_recoursion %}
						{% if level < navigationMaxDepth %}
							{% sw_include '@Storefront/storefront/layout/navigation/categories.html.twig' with {
							navigationTree: treeItem.children,
							level: level + 1,
							page: page
						} only %}
						{% endif %}
					{% endblock %}
				</li>
			{% endblock %}
		{% endfor %}
	</ul>
{% endblock %}

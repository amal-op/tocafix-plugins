{% sw_extends '@Storefront/storefront/layout/header/header.html.twig' %}

{% block layout_header %}
    {% block layout_top_bar %}{% endblock %}

    {% block layout_header_navigation %}
        <div class="header-wrap d-flex align-items-center justify-content-between">

            <div class="header-left-col d-flex col-auto col-md-2">
                {% block layout_header_navigation_toggle %}
                    <div class="header-actions-group d-flex align-items-center">
                        <div class="menu-button header-action-item d-flex d-md-none">
                            {% block layout_header_navigation_toggle_button %}
                                <button
                                    class="btn nav-main-toggle-btn header-actions-btn"
                                    type="button"
                                    data-off-canvas-menu="true"
                                    aria-label="{{ "general.menuLink"|trans|striptags }}"
                                >
                                    {% block layout_header_navigation_toggle_button_icon %}
                                        <i class="tf-icon icon-menu"></i>
                                    {% endblock %}
                                </button>
                            {% endblock %}
                            {% block layout_header_search_toggle_mobile %}
                                <button class="btn header-actions-btn search-toggle-btn js-search-toggle-btn collapsed"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#searchCollapse"
                                        aria-expanded="false"
                                        aria-controls="searchCollapse"
                                        aria-label="{{ "header.searchButton"|trans|striptags }}">
                                    <i class="tf-icon icon-search"></i>
                                    <span class="btn-text">Suche</span>
                                </button>
                            {% endblock %}
                        </div>
                    </div>
                {% endblock %}
                {% block layout_header_logo %}
                    <div class="header-logo-col">
                        {% sw_include '@Storefront/storefront/layout/header/logo-light.html.twig' %}
                        {% sw_include '@Storefront/storefront/layout/header/logo-dark.html.twig' %}
                    </div>
                {% endblock %}
            </div>

            {% block layout_header_nav %}
                <div class="header-center-col header-menu-col col-8 d-none d-md-flex justify-content-center">
                    {% sw_include '@Storefront/storefront/layout/navigation/offcanvas/navigation.html.twig' %}
                </div>
            {% endblock %}

            {% block layout_header_search %}{% endblock %}

            {% block layout_header_actions %}
                <div class="header-right-col col-2 d-flex align-items-center justify-content-end">
                    <div class="header-actions-group d-flex">

                        {% block layout_header_search_toggle %}
                            <div class="search-toggle header-action-item">
                                <button class="btn header-actions-btn d-none d-sm-flex search-toggle-btn js-search-toggle-btn collapsed"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#searchCollapse"
                                        aria-expanded="false"
                                        aria-controls="searchCollapse"
                                        aria-label="{{ "header.searchButton"|trans|striptags }}">
                                    <i class="tf-icon icon-search"></i>
                                    <span class="btn-text">Suche</span>
                                </button>
                                {% sw_include '@Storefront/storefront/layout/header/search.html.twig' %}
                            </div>
                        {% endblock %}

                    </div>
                    <div class="header-actions-group d-flex">
                        {% if config('core.cart.wishlistEnabled') %}
                            {% block layout_header_actions_wishlist %}
                                <div class="header-wishlist header-action-item">
                                    <a class="btn header-wishlist-btn header-actions-btn"
                                        href="{{ path('frontend.wishlist.page') }}"
                                        title="{{ 'header.wishlist'|trans|striptags }}"
                                        aria-label="{{ 'header.wishlist'|trans|striptags }}">
                                        {% sw_include '@Storefront/storefront/layout/header/actions/wishlist-widget.html.twig' %}
                                    </a>
                                </div>
                            {% endblock %}
                        {% endif %}

                        {% block layout_header_actions_account %}
                            <div class="account-menu header-action-item">
                                {% sw_include '@Storefront/storefront/layout/header/actions/account-widget.html.twig' %}
                            </div>
                        {% endblock %}

                        {% block layout_header_actions_cart %}
                             <div
                                class="header-cart header-action-item"
                                data-off-canvas-cart="true"
                            >
                                <a class="btn header-cart-btn header-actions-btn"
                                    href="{{ path('frontend.checkout.cart.page') }}"
                                    data-cart-widget="true"
                                    title="{{ 'checkout.cartTitle'|trans|striptags }}"
                                    aria-label="{{ 'checkout.cartTitle'|trans|striptags }}">
                                    {% sw_include '@Storefront/storefront/layout/header/actions/cart-widget.html.twig' %}
                                </a>
                            </div>
                        {% endblock %}
                        {% block layout_header_top_bar_language %}
                            <div class="language-dropdown header-action-item d-flex">
                                {% sw_include '@Storefront/storefront/layout/header/actions/language-widget.html.twig' %}
                            </div>
                        {% endblock %}
                    </div>
                </div>
            {% endblock %}
        </div>
    {% endblock %}
{% endblock %}

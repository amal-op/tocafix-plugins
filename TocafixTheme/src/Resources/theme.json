          "type": "fontFamily",
          "value": "'Open Sans', sans-serif",
          "editable": true,
          "block": "typography",
          "order": 100
        },
        "sw-font-family-headline": {
            "label": {
                "en-GB": "Headline font family",
                "de-DE": "Überschrift-Schriftfamilie"

{
  "name": "TocafixTheme",
  "author": "treestones",
  "previewMedia": "config/defaultThemePreview.png",
  "views": [
     "@Storefront",
     "@Plugins",
     "@TocafixTheme"
  ],
  "style": [
    "app/storefront/src/scss/overrides.scss",
    "@Storefront",
    "app/storefront/src/scss/base.scss"
  ],
  "script": [
    "@Storefront",
    "app/storefront/dist/storefront/js/tocafix-theme.js"
  ],
  "asset": [
    "@Storefront",
    "app/storefront/src/assets"
  ],
  "config": {
    "blocks": {
        "themeColors": {
            "label": {
                "en-GB": "Theme Colors",
                "de-DE": "Themenfarben"
            }
        },
        "typography": {
            "label": {
                "en-GB": "Typography",
                "de-DE": "Typografie"
            }
        },
        "statusColors": {
            "label": {
                "en-GB": "Status colors",
                "de-DE": "Statusfarben"
            }
        },
        "eCommerce": {
            "label": {
                "en-GB": "E-Commerce",
                "de-DE": "E-Commerce"
            }
        },
        "media": {
            "label": {
                "en-GB": "Media",
                "de-DE": "Medien"
            }
        },
        "themeSettings": {
            "label": {
                "en-GB": "Theme Settings",
                "de-DE": "Theme Settings"
            }
        }
    },
    "fields": {
        "sw-color-brand-primary": {
            "label": {
                "en-GB": "Brand Primary",
                "de-DE": "Marke primär"
            },
            "type": "color",
            "value": "#ED1B2F",
            "editable": true,
            "block": "themeColors",
            "order": 100
        },
        "sw-color-brand-secondary": {
            "label": {
                "en-GB": "Brand Secondary",
                "de-DE": "Marke zweitrangig"
            },
            "type": "color",
            "value": "#000000",
            "editable": true,
            "block": "themeColors",
            "order": 200
        },
        "sw-border-color": {
            "label": {
                "en-GB": "Border Color",
                "de-DE": "Randfarbe"
            },
            "type": "color",
            "value": "#BBBBBB",
            "editable": true,
            "block": "themeColors",
            "order": 300
        },
        "sw-background-color": {
            "label": {
                "en-GB": "Background Color",
                "de-DE": "Hintergrundfarbe"
            },
            "type": "color",
            "value": "#FFFFFF",
            "editable": true,
            "block": "themeColors",
            "order": 400
        },
        "sw-font-family-base": {
          "label": {
            "en-GB": "Base font family",
            "de-DE": "Basisschriftfamilie"

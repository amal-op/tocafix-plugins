export default "{% block tocafix_team_category_detail %}\n    <sw-page class=\"tocafix-team-category-detail\">\n        <template slot=\"smart-bar-actions\">\n            <sw-button :routerLink=\"{ name: 'tocafix.team.category.list' }\">\n                {{ $t('tocafix-team-category.detail.cancelButtonText') }}\n            </sw-button>\n\n            <sw-button-process\n                :isLoading=\"isLoading\"\n                :processSuccess=\"processSuccess\"\n                variant=\"primary\"\n                @process-finish=\"saveFinish\"\n                @click=\"onClickSave\">\n                {{ $t('tocafix-team-category.detail.saveButtonText') }}\n            </sw-button-process>\n        </template>\n\n        <template #language-switch>\n            <sw-language-switch slot=\"language-switch\" @on-change=\"onChangeLanguage\"></sw-language-switch>\n        </template>\n\n        <template slot=\"content\">\n            <sw-card-view>\n                <sw-card v-if=\"teamCategory\" :isLoading=\"isLoading\">\n                    <sw-field\n                        :label=\"$t('tocafix-team-category.detail.nameLabel')\"\n                        v-model=\"teamCategory.name\"\n                        required\n                        :error=\"teamCategoryNameError\">\n                    </sw-field>\n                </sw-card>\n            </sw-card-view>\n        </template>\n    </sw-page>\n{% endblock %}";
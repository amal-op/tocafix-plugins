export default "{% block sw_cms_element_tocafix_teams_config %}\n    <div class=\"sw-cms-el-config-tocafix-teams\">\n        <sw-container columns=\"1fr 1fr 1fr 1fr\" gap=\"20px\">\n            <sw-single-select :label=\"$t('tocafix.element.teams.config.category')\"\n                              :options=\"categories\" valueProperty=\"id\" labelProperty=\"name\"\n                              v-model=\"element.config.category.value\">\n                  <template #selection-label-property=\"{ item }\">\n                      {{ item.name || item.translated.name }}\n                  </template>\n                  <template #result-label-property=\"{ item }\">\n                      {{ item.name || item.translated.name }}\n                  </template>\n            </sw-single-select>\n\n            <sw-number-field numbertype=\"int\" :min=\"0\"\n                             :label=\"$tc('tocafix.element.teams.config.numberofposts.title')\"\n                             v-model=\"element.config.numberOfPosts.value\"\n                             :helpText=\"$tc('tocafix.element.teams.config.numberofposts.help')\"\n            ></sw-number-field>\n\n        </sw-container>\n    </div>\n{% endblock %}\n";
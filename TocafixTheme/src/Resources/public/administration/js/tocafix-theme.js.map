export default "{% block tocafix_team_detail %}\n    <sw-page class=\"tocafix-team-detail\">\n        <template slot=\"smart-bar-actions\">\n            <sw-button :routerLink=\"{ name: 'tocafix.team.category.list' }\">\n                {{ $t('tocafix-team.detail.manageTeamCategoryText') }}\n            </sw-button>\n\n            <sw-button :routerLink=\"{ name: 'tocafix.team.list' }\">\n                {{ $t('tocafix-team.detail.cancelButtonText') }}\n            </sw-button>\n\n            <sw-button-process\n                :isLoading=\"isLoading\"\n                :processSuccess=\"processSuccess\"\n                variant=\"primary\"\n                @process-finish=\"saveFinish\"\n                @click=\"onClickSave\">\n                {{ $t('tocafix-team.detail.saveButtonText') }}\n            </sw-button-process>\n        </template>\n\n        <template #language-switch>\n            <sw-language-switch slot=\"language-switch\" @on-change=\"onChangeLanguage\"></sw-language-switch>\n        </template>\n\n        <template slot=\"content\">\n            <sw-card-view>\n                <sw-card v-if=\"team\" :isLoading=\"isLoading\">\n                    <sw-field\n                        :label=\"$t('tocafix-team.detail.nameLabel')\"\n                        v-model=\"team.name\"\n                        required\n                        :error=\"teamNameError\">\n                    </sw-field>\n                    \n                    <sw-entity-many-to-many-select\n                        :label=\"$t('tocafix-team.detail.categoryLabel')\"\n                        :localMode=\"team.isNew()\"\n                        v-model=\"team.teamCategories\"\n                        valueLimit=\"2\">\n                    </sw-entity-many-to-many-select>\n\n                    <sw-field\n                        :label=\"$t('tocafix-team.detail.positionLabel')\"\n                        v-model=\"team.position\"\n                        required\n                        :error=\"teamPositionError\">\n                    </sw-field>\n\n                    <sw-field\n                        :label=\"$t('tocafix-team.detail.phoneNumberLabel')\"\n                        v-model=\"team.phoneNumber\">\n                    </sw-field>\n\n                    <sw-field\n                        :label=\"$t('tocafix-team.detail.emailLabel')\"\n                        v-model=\"team.email\"\n                        required\n                        :error=\"teamEmailError\">\n                    </sw-field>\n\n                    <sw-media-field\n                        :label=\"$t('tocafix-team.detail.mediaLabel')\"\n                        v-model=\"team.mediaId\">\n                    </sw-media-field>\n\n                    <sw-number-field\n                        :label=\"$t('tocafix-team.detail.sortOrderLabel')\"\n                        v-model=\"team.sortOrder\"\n                        numberType=\"int\"\n                        :step=\"1\"\n                        :min=\"1\"\n                        :allowEmpty=\"false\"\n                        required\n                        :error=\"teamPositionError\">\n                    </sw-number-field>\n                </sw-card>\n            </sw-card-view>\n        </template>\n    </sw-page>\n{% endblock %}";
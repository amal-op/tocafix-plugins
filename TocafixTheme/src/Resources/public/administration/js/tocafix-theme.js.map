export default "{% block tocafix_team_category_list %}\n    <sw-page class=\"tocafix-team-category-list\">\n\n        {% block tocafix_team_category_list_smart_bar_header %}\n            <template slot=\"smart-bar-header\">\n                {% block tocafix_team_category_list_smart_bar_header_title %}\n                    <h2>\n                        {% block tocafix_team_category_list_smart_bar_header_title_text %}\n                            {{ $tc('tocafix-team-category.list.textTeamOverview') }}\n                        {% endblock %}\n\n                        {% block tocafix_team_category_list_smart_bar_header_amount %}\n                            <span v-if=\"!isLoading\" class=\"sw-page__smart-bar-amount\">\n                                ({{ teamCategories.total }})\n                            </span>\n                        {% endblock %}\n                    </h2>\n                {% endblock %}\n            </template>\n        {% endblock %}\n\n        {% block tocafix_team_category_list_smart_bar_actions %}\n            <template slot=\"smart-bar-actions\">\n                <sw-button variant=\"primary\" :routerLink=\"{ name: 'tocafix.team.category.create' }\">\n                    {{ $t('tocafix-team-category.list.addButtonText') }}\n                </sw-button>\n            </template>\n        {% endblock %}\n\n        <template #language-switch>\n            <sw-language-switch @on-change=\"onChangeLanguage\"></sw-language-switch>\n        </template>\n\n        <template slot=\"content\">\n            {% block tocafix_team_category_list_content %}\n                <sw-entity-listing\n                    v-if=\"teamCategories\"\n                    :items=\"teamCategories\"\n                    :repository=\"repository\"\n                    :showSelection=\"false\"\n                    :columns=\"columns\"\n                    detailRoute=\"tocafix.team.category.detail\">\n                </sw-entity-listing>\n            {% endblock %}\n        </template>\n    </sw-page>\n{% endblock %}";
export default "{% block tocafix_job_list %}\n    <sw-page class=\"tocafix-job-list\">\n\n        {% block tocafix_job_list_smart_bar_header %}\n            <template slot=\"smart-bar-header\">\n                {% block tocafix_job_list_smart_bar_header_title %}\n                    <h2>\n                        {% block tocafix_job_list_smart_bar_header_title_text %}\n                            {{ $tc('tocafix-job.list.textJobOverview') }}\n                        {% endblock %}\n\n                        {% block tocafix_job_list_smart_bar_header_amount %}\n                            <span v-if=\"!isLoading\" class=\"sw-page__smart-bar-amount\">\n                                ({{ jobs.total }})\n                            </span>\n                        {% endblock %}\n                    </h2>\n                {% endblock %}\n            </template>\n        {% endblock %}\n\n        {% block tocafix_job_list_smart_bar_actions %}\n            <template slot=\"smart-bar-actions\">\n                <sw-button variant=\"primary\" :routerLink=\"{ name: 'tocafix.job.create' }\">\n                    {{ $t('tocafix-job.list.addButtonText') }}\n                </sw-button>\n            </template>\n        {% endblock %}\n\n        <template #language-switch>\n            <sw-language-switch @on-change=\"onChangeLanguage\"></sw-language-switch>\n        </template>\n\n        <template slot=\"content\">\n            {% block tocafix_job_list_content %}\n                <sw-entity-listing\n                    v-if=\"jobs\"\n                    :items=\"jobs\"\n                    :repository=\"repository\"\n                    :showSelection=\"false\"\n                    :columns=\"columns\"\n                    detailRoute=\"tocafix.job.detail\">\n                    {% block tocafix_job_list_grid_columns_job_date %}\n                        <template #column-jobDate=\"{ item }\">\n                            {{ item.jobDate|dateFilter() }}\n                        </template>\n                    {% endblock %}\n                </sw-entity-listing>\n            {% endblock %}\n        </template>\n    </sw-page>\n{% endblock %}";
export default "{% block tocafix_job_detail %}\n    <sw-page class=\"tocafix-job-detail\">\n        <template slot=\"smart-bar-actions\">\n            <sw-button :routerLink=\"{ name: 'tocafix.job.list' }\">\n                {{ $t('tocafix-job.detail.cancelButtonText') }}\n            </sw-button>\n\n            <sw-button-process\n                :isLoading=\"isLoading\"\n                :processSuccess=\"processSuccess\"\n                variant=\"primary\"\n                @process-finish=\"saveFinish\"\n                @click=\"onClickSave\">\n                {{ $t('tocafix-job.detail.saveButtonText') }}\n            </sw-button-process>\n        </template>\n\n        <template #language-switch>\n            <sw-language-switch slot=\"language-switch\" @on-change=\"onChangeLanguage\"></sw-language-switch>\n        </template>\n\n        <template slot=\"content\">\n            <sw-card-view>\n                <sw-card v-if=\"job\" :isLoading=\"isLoading\">\n                    <sw-field\n                        :label=\"$t('tocafix-job.detail.nameLabel')\"\n                        v-model=\"job.name\"\n                        required\n                        :error=\"jobNameError\">\n                    </sw-field>\n\n                    <sw-datepicker\n                        dateType=\"date\"\n                        :label=\"$t('tocafix-job.detail.jobDateLabel')\"\n                        size=\"default\"\n                        v-model=\"job.jobDate\"\n                        required\n                        :error=\"jobJobDateError\">\n                    </sw-datepicker>\n\n                    <sw-text-editor \n                        :label=\"$t('tocafix-job.detail.shortDescriptionTeaserLabel')\"\n                        v-model=\"job.shortDescriptionTeaser\">\n                    </sw-text-editor>\n\n                    <sw-text-editor \n                        :label=\"$t('tocafix-job.detail.shortDescriptionDetailLabel')\"\n                        v-model=\"job.shortDescriptionDetail\">\n                    </sw-text-editor>\n\n                    <sw-text-editor \n                        :label=\"$t('tocafix-job.detail.descriptionLabel')\"\n                        v-model=\"job.description\">\n                    </sw-text-editor>\n\n                    <sw-media-field\n                        :label=\"$t('tocafix-job.detail.mediaLabel')\"\n                        v-model=\"job.mediaId\">\n                    </sw-media-field>\n                </sw-card>\n            </sw-card-view>\n        </template>\n    </sw-page>\n{% endblock %}";
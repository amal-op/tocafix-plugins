{% block tocafix_team_detail %}
	<sw-page class="tocafix-team-detail">
		<template #smart-bar-actions>
			<sw-button @click="$router.push({ name: 'tocafix.team.category.list' })">
				{{ $t('tocafix-team.detail.manageTeamCategoryText') }}
			</sw-button>
			<sw-button @click="$router.push({ name: 'tocafix.team.list' })">
				{{ $tc('tocafix-team.detail.cancelButtonText') }}
			</sw-button>
			<sw-button-process :is-loading="isLoading" v-model:processsuccess="processSuccess" variant="primary" @process-finish="saveFinish" @click="onClickSave">
				{{ $t('tocafix-team.detail.saveButtonText') }}
			</sw-button-process>
		</template>

		<template #language-switch>
			<sw-language-switch slot="language-switch" @on-change="onChangeLanguage" :disabled="isNewTeam"></sw-language-switch>
		</template>

		<template #content>
			<sw-card-view>
				<sw-card v-if="team" :isloading="isLoading">
					<sw-text-field :label="$t('tocafix-team.detail.nameLabel')" v-model:value="team.name" required :error="teamNameError"></sw-text-field>

					<sw-entity-many-to-many-select entity="tocafix_team_category" :label="$t('tocafix-team.detail.categoryLabel')" :local-mode="true" :entity-collection="team.teamCategories" @update:entity-collection="onTeamCategoriesChange"></sw-entity-many-to-many-select>

					<sw-text-field :label="$t('tocafix-team.detail.positionLabel')" v-model:value="team.position" required :error="teamPositionError"></sw-text-field>

					<sw-text-field type="email" :label="$t('tocafix-team.detail.emailLabel')" v-model:value="team.email" required :error="teamEmailError"></sw-text-field>

					<sw-text-field :label="$t('tocafix-team.detail.phoneNumberLabel')" v-model:value="team.phoneNumber"></sw-text-field>

					<sw-media-field :label="$t('tocafix-team.detail.mediaLabel')" v-model:value="team.mediaId"></sw-media-field>

					<sw-number-field :label="$t('tocafix-team.detail.sortOrderLabel')" v-model:value="team.sortOrder" numbertype="int" :step="1" :min="1" :allowempty="false" required :error="teamSortOrderError"></sw-number-field>
				</sw-card>
			</sw-card-view>
		</template>
	</sw-page>
{% endblock %}
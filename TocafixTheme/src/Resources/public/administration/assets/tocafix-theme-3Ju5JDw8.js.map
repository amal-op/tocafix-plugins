{% block tocafix_team_list %}
    <sw-page class="tocafix-team-list">

        {% block tocafix_team_list_smart_bar_header %}
            <template #smart-bar-header>
                {% block tocafix_team_list_smart_bar_header_title %}
                    <h2>
                        {% block tocafix_team_list_smart_bar_header_title_text %}
                            {{ $tc('tocafix-team.list.textTeamOverview') }}
                        {% endblock %}

                        {% block tocafix_team_list_smart_bar_header_amount %}
                            <span v-if="!isLoading && teams" class="sw-page__smart-bar-amount">
                                ({{ teams.total }})
                            </span>
                        {% endblock %}
                    </h2>
                {% endblock %}
            </template>
        {% endblock %}

        {% block tocafix_team_list_smart_bar_actions %}
            <template #smart-bar-actions>
                <sw-button 
                    variant="primary" 
                    :router-link="{ name: 'tocafix.team.create' }">
                    {{ $t('tocafix-team.list.addButtonText') }}
                </sw-button>
            </template>
        {% endblock %}

        {% block tocafix_team_list_language_switch %}
            <template #language-switch>
                <sw-language-switch @on-change="onChangeLanguage"></sw-language-switch>
            </template>
        {% endblock %}

        <template #content>
            {% block tocafix_team_list_content %}
                <sw-entity-listing
                    v-if="teams"
                    :items="teams"
                    :repository="teamRepository"
                    :show-selection="false"
                    :columns="columns"
                    detail-route="tocafix.team.detail">
                </sw-entity-listing>
            {% endblock %}
        </template>
    </sw-page>
{% endblock %}
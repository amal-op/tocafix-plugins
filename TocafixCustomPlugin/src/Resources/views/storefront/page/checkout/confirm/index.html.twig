{% sw_extends '@Storefront/storefront/page/checkout/confirm/index.html.twig' %}

{% block page_checkout_finish_customer_comment %}
{% sw_include '@Storefront/storefront/component/commission.html.twig' %}
    <div class="card checkout-card pb-4">
        <div class="card-body">
            {% block page_checkout_confirm_customer_reference_header %}
                <div class="card-title">
                    {{ "tocafix-custom.detailInformation.customerReferenceHeader"|trans|sw_sanitize }} {{ "general.required"|trans|sw_sanitize }}
                </div>
            {% endblock %}

            {% block page_checkout_confirm_customer_reference_control %}
                <div class="checkout-customer-comment-control">
                    {% block page_checkout_confirm_customer_reference_control_textfield_label %}
                        <label class="form-label" for="customerReference">
                            {{ "tocafix-custom.detailInformation.customerReferenceLabel"|trans|sw_sanitize }}
                        </label>
                    {% endblock %}

                    {% block page_checkout_confirm_customer_reference_control_textfield %}
                        <input type="text" class="form-control"
                                    placeholder="{{ "tocafix-custom.detailInformation.customerReferencePlaceHolder"|trans|sw_sanitize }}"
                                    id="customerReference"
                                    form="confirmOrderForm"
                                    name="customerReference"
                                    required="required">
                    {% endblock %}
                </div>
            {% endblock %}
        </div>
    </div>
    {{ parent() }}
{% endblock %}